{
  "title": "Priority ERP",
  "key_help": "Priority: the password of a user with an API license",
  "network": "owner",
  "credential": {
    "secret": "priority",
    "inject": "basic",
    "match": [
      "GET /odata/Priority/{ini}/{company}/$metadata",
      "GET /odata/Priority/{ini}/{company}/GetPriorityVersion()",
      "GET /odata/Priority/{ini}/{company}/{screen}",
      "POST /odata/Priority/{ini}/{company}/{screen}"
    ]
  },
  "writes": [
    { "match": "* /odata/Priority/{ini}/{company}/$batch", "decide": "deny" },
    {
      "match": "* /odata/Priority/{ini}/{company}/{PATOKENS|OAUTH2CONFIG|APIURLS|USERS|USERSB|USERSC|USERLIST|GROUPUSER|PRIVUSERS|PRIVFORM|PRIVCAT|DATAPRIV|CLMNPRIV|MENUPRIV|EXECUSERPRIV|USERMODPRIV|USERMODULEPRIV|MODULEUSERPRIV|SYSCONST|TRSYSCONST|CONST|WEBCONST|MAILSERVERS|MAILBOXSEND|LICENSETYPES}",
      "decide": "deny"
    },
    {
      "match": "POST /odata/Priority/{ini}/{company}/{screen}",
      "decide": "ask"
    },
    { "match": "* *", "decide": "deny" }
  ],
  "secret_responses": [
    "GET /odata/Priority/{ini}/{company}/{PATOKENS|OAUTH2CONFIG|MAILSERVERS}"
  ],
  "variable": "PRIORITY_PASSWORD",
  "url_variable": "PRIORITY_URL"
}
